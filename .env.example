# CornAgent 全量配置。复制为项目根目录 .env 后修改，.env 不提交到 Git。
# 系统环境变量优先于 .env；空值使用代码默认值（可选密钥默认未设置）。
# 路径相对于项目根目录；数组使用 JSON；字节/秒为单位，另有标注除外。
# 含 # 或空格的值请加引号；连接 URL 中的用户名/密码需做 URL 编码。

# 运行环境与前后端启动；make dev / server 的 make dev 使用以下配置。
CORNAGENT_ENVIRONMENT=local
CORNAGENT_SERVER_HOST=127.0.0.1
CORNAGENT_SERVER_PORT=8000
CORNAGENT_SERVER_RELOAD=true
CORNAGENT_SERVER_LOG_LEVEL=info
CORNAGENT_FRONTEND_HOST=127.0.0.1
CORNAGENT_FRONTEND_PORT=5173
CORNAGENT_FRONTEND_DIST=frontend/dist
CORNAGENT_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# 主模型：API key、Base URL、模型名。
CORNAGENT_AGENT_API_KEY=
CORNAGENT_AGENT_API_BASE=https://api.deepseek.com
CORNAGENT_AGENT_MODEL=deepseek-v4-flash-vision-exp
CORNAGENT_AGENT_MODEL_TIMEOUT_SECONDS=120

# 可选备用模型：只有配置备用 API key 时启用。
CORNAGENT_AGENT_FALLBACK_API_KEY=
CORNAGENT_AGENT_FALLBACK_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
CORNAGENT_AGENT_FALLBACK_MODEL=deepseek-v4-flash-0731
CORNAGENT_AGENT_FALLBACK_SUPPORTS_IMAGES=false
CORNAGENT_AGENT_MODEL_MAX_RETRIES=2
CORNAGENT_AGENT_RETRY_BASE_DELAY_SECONDS=0.5
CORNAGENT_AGENT_RETRY_MAX_DELAY_SECONDS=4

# PostgreSQL：默认使用本机系统用户。带认证格式：
# postgresql+psycopg://username:password@127.0.0.1:5432/cornagent
CORNAGENT_DATABASE_URL=postgresql+psycopg://localhost:5432/cornagent
CORNAGENT_DATABASE_POOL_SIZE=10
CORNAGENT_DATABASE_MAX_OVERFLOW=10
# Redis：支持 redis://username:password@host:6379/0；TLS 使用 rediss://。
CORNAGENT_REDIS_URL=redis://127.0.0.1:6379/0

# 私有文件存储：local 或 s3。本地部署使用持久目录。
CORNAGENT_FILE_STORE_BACKEND=local
CORNAGENT_FILE_STORE_PATH=server/.data/files
# S3 / MinIO 等兼容服务；AWS S3 的 endpoint 留空。
CORNAGENT_S3_BUCKET=
CORNAGENT_S3_ENDPOINT_URL=
CORNAGENT_S3_REGION=us-east-1
CORNAGENT_S3_PREFIX=cornagent/
# 留空时沿用 AWS SDK 标准凭据链（环境变量、共享凭据、工作负载角色）。
CORNAGENT_S3_ACCESS_KEY_ID=
CORNAGENT_S3_SECRET_ACCESS_KEY=
CORNAGENT_S3_SESSION_TOKEN=

# Agent 调度、恢复、并发与限流。
CORNAGENT_AGENT_RECONCILE_SECONDS=5
CORNAGENT_AGENT_MAX_CONCURRENCY=20
# Root 与 Child 共用上述实例执行名额；等待用户/子任务时释放。
CORNAGENT_AGENT_SUBAGENTS_ENABLED=true
# 关闭仅停止新派发；已存在的子任务继续恢复、交付与取消。
CORNAGENT_AGENT_SUBAGENT_MODEL=
# 子模型名留空沿用主模型；连接与重试配置仍使用服务端主模型配置。
CORNAGENT_AGENT_SUBAGENT_SPAWN_MAX_TASKS=10
CORNAGENT_AGENT_SUBAGENT_RUN_MAX_TASKS=10
CORNAGENT_AGENT_SUBAGENT_RUN_MAX_CONCURRENCY=5
CORNAGENT_AGENT_SUBAGENT_TIMEOUT_SECONDS=600
CORNAGENT_AGENT_SUBAGENT_WAIT_DEFAULT_SECONDS=300
CORNAGENT_AGENT_SUBAGENT_RECONCILE_SECONDS=1
CORNAGENT_AGENT_SUBAGENT_RESULT_BATCH_MAX_BYTES=65536
CORNAGENT_AGENT_SUBAGENT_RESULT_PROJECTION_MAX_CHARS=8000
CORNAGENT_AGENT_SUBAGENT_FINAL_CANDIDATE_MAX_BYTES=262144
# 单个结果完整交付，可超过分批目标；整个 checkpoint 硬限制为 3 MiB。
# Root 与 Child 默认均挂载 mock_web_search；只返回本地固定模拟资料。
CORNAGENT_AGENT_MOCK_TOOLS_ENABLED=true
CORNAGENT_AGENT_USER_RUNS_PER_MINUTE=6
CORNAGENT_AGENT_TENANT_RUNS_PER_MINUTE=60
CORNAGENT_AGENT_IDENTITY_STREAM_CONNECTIONS=8
CORNAGENT_AGENT_RUN_STREAM_CONNECTIONS=4

# SSE 与 Redis Stream；batch window 单位为毫秒。
CORNAGENT_EVENT_HEARTBEAT_SECONDS=5
CORNAGENT_EVENT_POLL_SECONDS=0.25
CORNAGENT_AGENT_STREAM_MAX_EVENTS=1000
CORNAGENT_AGENT_STREAM_BATCH_WINDOW_MS=32
CORNAGENT_AGENT_STREAM_BATCH_MAX_BYTES=4096
CORNAGENT_AGENT_STREAM_ACTIVE_TTL_SECONDS=86400
CORNAGENT_AGENT_STREAM_TERMINAL_TTL_SECONDS=10800

# 上下文压缩；summary max tokens 为 token 数。
CORNAGENT_AGENT_CONTEXT_CHECKPOINT_TRIGGER_RATIO=0.8
CORNAGENT_AGENT_CONTEXT_SUMMARY_MAX_TOKENS=4096

# 附件输入：图片和 PDF。
CORNAGENT_AGENT_FILE_INPUT_ENABLED=true
CORNAGENT_AGENT_FILE_IMAGE_MIME_TYPES=["image/jpeg","image/png","image/webp"]
CORNAGENT_AGENT_FILE_MAX_COUNT=4
CORNAGENT_AGENT_FILE_MAX_TOTAL_BYTES=16777216
CORNAGENT_AGENT_FILE_IMAGE_MAX_BYTES=5242880
CORNAGENT_AGENT_FILE_IMAGE_MAX_SIDE=8192
CORNAGENT_AGENT_FILE_IMAGE_MAX_PIXELS=25000000
CORNAGENT_AGENT_FILE_IMAGE_HYDRATION_MAX_COUNT=16
CORNAGENT_AGENT_FILE_IMAGE_HYDRATION_MAX_BYTES=16777216
CORNAGENT_AGENT_FILE_PDF_MAX_BYTES=2097152
CORNAGENT_AGENT_FILE_PDF_MAX_COUNT=1
CORNAGENT_AGENT_FILE_PDF_MAX_PAGES=50
CORNAGENT_AGENT_FILE_EXTRACTION_TIMEOUT_SECONDS=20
CORNAGENT_AGENT_FILE_EXTRACTED_MAX_CHARS=200000
